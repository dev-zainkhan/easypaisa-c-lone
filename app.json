{
  "expo": {
    "name": "easypaisa",
    "slug": "easypaisa-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.assessment.easypaisaclone",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.assessment.easypaisaclone"
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow easypaisa to save transaction receipts to your gallery.",
          "savePhotosPermission": "Allow easypaisa to save transaction receipts to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
